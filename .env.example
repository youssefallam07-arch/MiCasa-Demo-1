# Copy to .env (gitignored). Real secrets never committed.

# ---- Centcom API ----
CENTCOM_PORT=4000

# REQUIRED — the server refuses to boot if this is missing or a known placeholder.
# Generate a strong value with:  openssl rand -hex 32
JWT_SECRET=

JWT_EXPIRES=12h

# Comma-separated browser origins allowed to call the API.
# (Apps served by centcom itself are same-origin and always allowed.)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# ---- Mainframe database ----
# SQLite now (zero-config). To migrate to Postgres/Supabase later, change to a
# postgresql:// URL and update packages/mainframe/prisma/schema.prisma datasource.
DATABASE_URL="file:./prisma/dev.db"

# ---- App -> API base (Vite reads VITE_* at build/dev time) ----
VITE_API_BASE=http://localhost:4000
