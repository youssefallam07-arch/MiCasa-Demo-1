# Copy to .env (gitignored). Real secrets never committed.
# ---- Centcom API ----
CENTCOM_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h

# ---- Mainframe database ----
# SQLite now (zero-config). To migrate to Postgres/Supabase later, change to a
# postgresql:// URL and update packages/mainframe/prisma/schema.prisma datasource.
DATABASE_URL="file:./prisma/dev.db"

# ---- App -> API base (Vite reads VITE_* at build/dev time) ----
VITE_API_BASE=http://localhost:4000
